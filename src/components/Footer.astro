---
import { siteConfig } from '../data/site';
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div>
      <a class="footer-name" href="/">{siteConfig.englishName} · {siteConfig.name}</a>
      <p>Personal academic homepage.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer { padding: 2.5rem 0; color: rgba(255,255,255,.82); background: linear-gradient(135deg, #2c3e50 0%, #34495e 100%); }
  .footer-inner { display: flex; align-items: flex-end; gap: 2rem; }
  .footer-name { color: white; font-family: var(--font-display); font-size: 1.05rem; font-weight: 400; }
  p { margin: .55rem 0 0; color: rgba(255,255,255,.62); font-size: .8rem; }
</style>
