---
import Icon from './Icon.astro';
import { siteConfig } from '../data/site';
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div>
      <a class="footer-name" href="/">{siteConfig.englishName} · {siteConfig.name}</a>
      <p>Personal academic homepage.</p>
    </div>
    <div class="footer-meta">
      <a class="email-link" href={`mailto:${siteConfig.email}`} aria-label="Email"><Icon name="email" size={17} /></a>
    </div>
  </div>
</footer>

<style>
  .site-footer { padding: 2rem 0 2.5rem; border-top: 1px solid var(--line); }
  .footer-inner { display: flex; align-items: flex-end; justify-content: space-between; gap: 2rem; }
  .footer-name { font-family: var(--font-display); font-size: 1.05rem; font-weight: 650; }
  p { margin: .55rem 0 0; color: var(--muted); font-size: .78rem; }
  .footer-meta { text-align: right; }
  .email-link { width: 2rem; height: 2rem; display: inline-grid; place-items: center; border: 1px solid var(--line-strong); border-radius: 50%; color: var(--muted); }
  @media (max-width: 640px) { .footer-inner { align-items: flex-start; flex-direction: column; } .footer-meta { text-align: left; } }
</style>
