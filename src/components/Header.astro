---
import { siteConfig } from '../data/site';

const navItems = [
  { label: 'Learning', href: '/#learning' },
  { label: 'Research', href: '/#research' },
  { label: 'About', href: '/#about' },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={`${siteConfig.englishName}, home`}>
      <span class="brand-mark" aria-hidden="true">{siteConfig.initials}</span>
      <span class="brand-name">{siteConfig.englishName}<small>{siteConfig.name}</small></span>
    </a>
    <nav aria-label="Primary navigation">
      <ul>{navItems.map((item) => <li><a href={item.href}>{item.label}</a></li>)}</ul>
    </nav>
    <a class="header-contact" href={`mailto:${siteConfig.email}`}>Email</a>
  </div>
</header>

<style>
  .site-header { position: sticky; z-index: 30; top: 0; border-bottom: 1px solid color-mix(in srgb, var(--line) 82%, transparent); background: color-mix(in srgb, var(--paper) 92%, transparent); backdrop-filter: blur(16px); }
  .header-inner { min-height: 68px; display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; }
  .brand { display: inline-flex; align-items: center; gap: .72rem; color: var(--ink); font-weight: 720; letter-spacing: -.02em; }
  .brand-mark { width: 2rem; height: 2rem; display: grid; place-items: center; border: 1px solid var(--line-strong); border-radius: 50%; color: var(--violet); font-family: var(--font-display); font-size: .72rem; font-style: italic; }
  .brand-name { display: inline-flex; align-items: baseline; gap: .5rem; }
  .brand-name small { color: var(--muted); font-size: .7rem; font-weight: 650; }
  nav ul { display: flex; align-items: center; gap: clamp(1rem, 2.5vw, 2rem); margin: 0; padding: 0; list-style: none; }
  nav a { color: var(--muted); font-size: .82rem; font-weight: 650; transition: color 160ms ease; }
  nav a:hover, nav a:focus-visible { color: var(--ink); }
  .header-contact { padding: .62rem .95rem; border: 1px solid var(--line-strong); border-radius: 999px; font-size: .8rem; font-weight: 700; transition: color 160ms ease, border-color 160ms ease, background 160ms ease; }
  .header-contact:hover { border-color: var(--ink); color: var(--paper); background: var(--ink); }
  @media (max-width: 680px) { .header-inner { min-height: 62px; gap: .8rem; } .brand-name, .header-contact { display: none; } nav ul { gap: .8rem; } nav a { font-size: .76rem; } }
</style>
