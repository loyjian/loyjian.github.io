---
import { siteConfig } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <h1>Security in the unseen signals.</h1>
        <p class="hero-intro">Information leakage from the physical behavior of embedded devices, with methods for analysis and mitigation.</p>
      </div>

      <figure class="hero-image">
        <img src="/rainy-transit-dusk.webp" alt="Rainy landscape seen through a transit window at dusk" />
        <blockquote>结局无非两种，<br /><strong>好事，好故事</strong></blockquote>
      </figure>
    </div>
  </section>

  <section class="section" id="education">
    <div class="container">
      <h2 class="section-title">Education</h2>
      <div class="education-card">
        <div class="education-mark" aria-hidden="true"><img src="/hnust-emblem.png" alt="" /></div>
        <div class="education-copy">
          <h3>{siteConfig.education.school}</h3>
          <p>{siteConfig.education.degree} · {siteConfig.education.period}</p>
          <p><strong>Major:</strong> {siteConfig.education.major}</p>
          <p>{siteConfig.education.details}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-muted" id="learning">
    <div class="container">
      <h2 class="section-title">Current Learning</h2>
      <div class="learning-grid">
        {siteConfig.learning.map((item) => (
          <article class="learning-card">
            <span class="item-number">{item.index}</span>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="research">
    <div class="container">
      <h2 class="section-title">Research</h2>
      <div class="research-list">
        {siteConfig.research.map((item, index) => (
          <article class="research-card">
            <div class="research-number">0{index + 1}</div>
            <div class="research-copy">
              <h3>{item.title}</h3>
              <p>{item.summary}</p>
              <ul>{item.tags.map((tag) => <li>{tag}</li>)}</ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-muted" id="about">
    <div class="container">
      <h2 class="section-title">About</h2>
      <p class="about-text">
        Current research interests in side-channel analysis are being developed with guidance from the <a href={siteConfig.lab.url} target="_blank" rel="noreferrer">Laboratory of Intelligent Systems and Applications</a> at Hunan University of Science and Technology.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { position: relative; overflow: hidden; padding: clamp(4.5rem, 8vw, 7rem) 0; color: white; background: radial-gradient(circle at 18% 20%, rgba(75,111,235,.34), transparent 30rem), radial-gradient(circle at 82% 75%, rgba(0,180,205,.2), transparent 28rem), linear-gradient(135deg, #080d1e 0%, #111a37 46%, #182c58 100%); }
  .hero::after { position: absolute; inset: 0; background-image: radial-gradient(circle at center, rgba(255,255,255,.28) 0 1px, transparent 1.5px); background-size: 52px 52px; opacity: .12; content: ''; pointer-events: none; }
  .hero-grid { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(340px, .75fr); align-items: center; gap: clamp(3rem, 7vw, 7rem); }
  h1 { max-width: 720px; margin: 0; font-family: var(--font-display); font-size: clamp(3rem, 5.6vw, 5rem); font-weight: 400; letter-spacing: -.035em; line-height: 1.08; }
  .hero-intro { max-width: 660px; margin: 1.6rem 0 0; color: rgba(255,255,255,.78); font-size: 1.06rem; line-height: 1.75; }
  .hero-image { position: relative; margin: 0; overflow: hidden; border: 1px solid rgba(255,255,255,.22); border-radius: 20px; box-shadow: 0 22px 60px rgba(0,0,0,.3); }
  .hero-image::after { position: absolute; inset: 0; background: linear-gradient(180deg, transparent 35%, rgba(4,8,18,.68) 100%); content: ''; }
  .hero-image img { display: block; width: 100%; height: 300px; object-fit: cover; object-position: center 58%; }
  .hero-image blockquote { position: absolute; z-index: 1; right: 1.5rem; bottom: 1.35rem; left: 1.5rem; margin: 0; color: rgba(255,255,255,.86); font-family: "Songti SC", "Noto Serif SC", serif; font-size: .94rem; line-height: 1.7; }
  .hero-image blockquote strong { color: white; font-size: 1.25rem; font-weight: 600; }
  .section { padding: clamp(4rem, 7vw, 5rem) 0; border-bottom: 1px solid var(--line); }
  .section-muted { background: var(--surface-muted); }
  .section-title { position: relative; display: inline-block; margin: 0 0 3rem; color: var(--ink); font-family: var(--font-display); font-size: clamp(2.1rem, 4vw, 2.5rem); font-weight: 400; letter-spacing: -.025em; line-height: 1.15; }
  .section-title::after { position: absolute; bottom: -.8rem; left: 0; width: 60px; height: 4px; border-radius: 999px; background: linear-gradient(90deg, var(--primary), #667eea); content: ''; }
  .education-card { display: grid; grid-template-columns: 82px minmax(0, 1fr); align-items: center; gap: 1.5rem; max-width: 920px; padding: 1.6rem; border: 1px solid var(--line); border-radius: 18px; background: white; box-shadow: var(--shadow-md); }
  .education-mark { width: 72px; height: 72px; display: grid; place-items: center; border-radius: 50%; background: #0799d1; }
  .education-mark img { width: 58px; height: 58px; object-fit: contain; filter: brightness(0) invert(1); }
  .education-copy h3 { margin: 0 0 .55rem; overflow-wrap: anywhere; font-family: var(--font-display); font-size: 1.45rem; font-weight: 400; }
  .education-copy p { margin: .25rem 0 0; color: var(--muted); font-size: .94rem; line-height: 1.55; }
  .education-copy strong { color: var(--ink); font-weight: 600; }
  .learning-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; }
  .learning-card { position: relative; min-height: 220px; padding: 2rem; border: 1px solid var(--line); border-radius: 20px; background: white; box-shadow: var(--shadow-md); transition: transform .25s ease, box-shadow .25s ease; }
  .learning-card:hover { transform: translateY(-5px); box-shadow: var(--shadow-lg); }
  .item-number { color: var(--primary); font-size: .82rem; font-weight: 700; }
  .learning-card h3 { margin: 2.15rem 0 .75rem; color: var(--ink); font-family: var(--font-display); font-size: 1.5rem; font-weight: 400; line-height: 1.3; }
  .learning-card p { margin: 0; color: var(--muted); font-size: .96rem; line-height: 1.75; }
  .research-list { display: grid; gap: 1.25rem; }
  .research-card { display: grid; grid-template-columns: 92px minmax(0, 1fr); gap: 1.5rem; padding: 1.8rem; border: 1px solid var(--line); border-radius: 20px; background: white; box-shadow: var(--shadow-sm); transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease; }
  .research-card:hover { transform: translateY(-4px); border-color: rgba(0,102,204,.25); box-shadow: var(--shadow-lg); }
  .research-number { display: grid; place-items: center; align-self: start; min-height: 68px; border-radius: 16px; color: var(--primary); background: var(--primary-soft); font-family: var(--font-display); font-size: 1.45rem; }
  .research-copy h3 { margin: 0; overflow-wrap: anywhere; color: var(--ink); font-family: var(--font-display); font-size: clamp(1.35rem, 2.2vw, 1.65rem); font-weight: 400; line-height: 1.4; }
  .research-copy > p { max-width: 920px; margin: .75rem 0 0; color: var(--muted); font-size: .96rem; line-height: 1.72; }
  .research-copy ul { display: flex; flex-wrap: wrap; gap: .5rem; margin: 1rem 0 0; padding: 0; list-style: none; }
  .research-copy li { padding: .34rem .7rem; border-radius: 999px; color: var(--primary); background: var(--primary-soft); font-size: .78rem; font-weight: 600; }
  .about-text { max-width: 1100px; margin: 0; color: var(--muted); font-size: 1.05rem; line-height: 1.8; }
  .about-text a { color: var(--primary); font-weight: 600; }
  .about-text a:hover { color: var(--primary-dark); text-decoration: underline; }
  @media (max-width: 820px) { .hero-grid { grid-template-columns: 1fr; } .hero-image { max-width: 560px; } .learning-grid { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .hero { padding: 3.75rem 0; } .hero-image img { height: 235px; } .section-title { margin-bottom: 2.5rem; } .education-card { grid-template-columns: 52px minmax(0, 1fr); align-items: start; gap: .85rem; padding: 1.1rem; } .education-mark { width: 48px; height: 48px; } .education-mark img { width: 39px; height: 39px; } .education-copy h3 { font-size: 1.25rem; line-height: 1.3; } .education-copy p { font-size: .84rem; } .research-card { grid-template-columns: 1fr; padding: 1.35rem; } .research-number { width: 58px; min-height: 48px; } }
</style>
