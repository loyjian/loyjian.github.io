---
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { siteConfig } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <section class="hero">
    <div class="signal-field" aria-hidden="true">
      <svg viewBox="0 0 760 300" preserveAspectRatio="none">
        <path d="M0 161 C68 161 78 160 106 160 S146 158 172 158 C191 158 194 36 213 36 C232 36 235 267 254 267 C273 267 279 104 298 104 C318 104 320 200 340 200 C362 200 366 142 389 142 C414 142 419 164 445 164 S506 160 545 160 C586 160 603 158 646 158 S715 160 760 160" />
        <path class="faint" d="M0 181 C120 181 116 174 180 174 C210 174 219 219 249 219 C279 219 285 124 315 124 C345 124 358 180 391 180 C438 180 465 177 510 177 S650 181 760 181" />
      </svg>
    </div>

    <div class="container hero-grid">
      <div class="hero-copy">
        <h1>Security in the<br /><em>unseen signals.</em></h1>
        <p class="hero-intro">{siteConfig.introduction}</p>
        <div class="hero-actions">
          <a class="button" href="#research">View research <Icon name="arrow" size={17} /></a>
        </div>
      </div>

      <aside class="identity-card" aria-label="Profile summary">
        <div class="portrait-visual">
          <img src="/rainy-transit-dusk.webp" alt="Rainy landscape seen through a transit window at dusk" />
          <blockquote>结局无非两种，<br /><strong>好事，好故事</strong></blockquote>
        </div>
      </aside>
    </div>
  </section>

  <section class="education-section" aria-labelledby="education-title">
    <div class="container education-row">
      <p class="eyebrow-text" id="education-title">Education</p>
      <div class="education-mark" aria-hidden="true">
        <img src="/hnust-emblem.png" alt="" />
      </div>
      <div class="education-copy">
        <h2>{siteConfig.education.school}</h2>
        <p>{siteConfig.education.degree} · {siteConfig.education.period}</p>
        <small>{siteConfig.education.details}</small>
      </div>
    </div>
  </section>

  <section class="section section-rule" id="learning">
    <div class="container">
      <SectionHeading
        eyebrow="Current learning"
        title="FPGA & Side-Channel Analysis"
        description="Topics include digital design workflows for FPGA platforms and the experimental methodology of side-channel analysis."
      />
      <div class="focus-grid">
        {siteConfig.learning.map((item) => (
          <article class="focus-card">
            <span class="focus-index">{item.index}</span>
            <div class="focus-glyph" aria-hidden="true"><i></i></div>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section research-section" id="research">
    <div class="container">
      <p class="eyebrow-text research-heading">Research</p>
      <div class="research-list">
        {siteConfig.research.map((item, index) => (
          <article class="research-card">
            <div class="research-number">0{index + 1}</div>
            <div class="research-copy">
              <p class="research-label">{item.label}</p>
              <h3>{item.title}</h3>
              <p>{item.summary}</p>
              <ul>{item.tags.map((tag) => <li>{tag}</li>)}</ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-rule" id="about">
    <div class="container about-grid">
      <p class="eyebrow-text about-label">About</p>
      <div class="about-content">
        <p class="lead">
          Research activities in side-channel analysis are conducted with the
          <a href={siteConfig.lab.url} target="_blank" rel="noreferrer">{siteConfig.lab.name}</a>.
        </p>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .hero { position: relative; min-height: 650px; display: grid; align-items: center; padding: clamp(4rem, 7vw, 6.5rem) 0; overflow: hidden; }
  .signal-field { position: absolute; width: min(56vw, 720px); right: -6vw; top: 8%; opacity: .22; pointer-events: none; }
  .signal-field svg { width: 100%; overflow: visible; }
  .signal-field path { fill: none; stroke: var(--violet); stroke-width: 1.2; vector-effect: non-scaling-stroke; }
  .signal-field .faint { opacity: .3; stroke-dasharray: 3 8; }
  .hero-grid { position: relative; display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(280px, .65fr); align-items: center; gap: clamp(3rem, 7vw, 6rem); }
  .hero-copy { position: relative; z-index: 2; }
  h1 { margin: 0; font-family: var(--font-display); font-size: clamp(3.4rem, 6.2vw, 6rem); font-weight: 430; letter-spacing: -.062em; line-height: .92; }
  h1 em { color: var(--violet); font-weight: 400; }
  .hero-intro { max-width: 650px; margin: 1.65rem 0 0; color: var(--muted); font-size: clamp(1rem, 1.4vw, 1.08rem); line-height: 1.75; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: .7rem; margin-top: 1.75rem; }
  .identity-card { position: relative; z-index: 2; padding: 1rem; border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--paper-raised); box-shadow: var(--shadow-soft); }
  .portrait-visual { position: relative; min-height: 215px; overflow: hidden; border-radius: 10px; background: #303849; }
  .portrait-visual::after { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(13,17,27,.04) 18%, rgba(13,17,27,.66) 100%); content: ''; }
  .portrait-visual img { position: absolute; width: 100%; height: 100%; object-fit: cover; object-position: center 58%; }
  .portrait-visual blockquote { position: absolute; z-index: 1; right: 1.25rem; bottom: 1.15rem; left: 1.25rem; margin: 0; color: rgba(255,255,255,.86); font-family: "Songti SC", "Noto Serif SC", var(--font-display); font-size: .92rem; letter-spacing: .04em; line-height: 1.65; text-shadow: 0 2px 18px rgba(0,0,0,.65); }
  .portrait-visual blockquote strong { color: white; font-size: 1.23rem; font-weight: 560; }
  .education-section { padding: 2rem 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); background: var(--paper-raised); }
  .education-row { display: grid; grid-template-columns: minmax(110px, .3fr) 58px minmax(0, 1.7fr); align-items: center; gap: clamp(1rem, 2.5vw, 2rem); }
  .education-mark { width: 54px; height: 54px; display: grid; place-items: center; border-radius: 50%; background: #0799d1; }
  .education-mark img { width: 44px; height: 44px; object-fit: contain; filter: brightness(0) invert(1); }
  .education-copy { min-width: 0; }
  .education-copy h2 { margin: 0; overflow-wrap: anywhere; font-family: var(--font-display); font-size: 1.25rem; font-weight: 600; letter-spacing: -.02em; }
  .education-copy p { margin: .32rem 0 0; color: var(--muted); font-size: .86rem; }
  .education-copy small { display: block; margin-top: .22rem; color: var(--muted); font-size: .78rem; }
  .focus-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }
  .focus-card { min-height: 230px; padding: clamp(1.4rem, 2.5vw, 1.9rem); border: 1px solid var(--line); border-radius: var(--radius-md); background: var(--paper-raised); }
  .focus-index { color: var(--muted); font-family: var(--font-display); font-size: .8rem; font-style: italic; }
  .focus-glyph { width: 3.8rem; height: 3.8rem; display: grid; place-items: center; margin: 1.5rem 0 1.4rem; border: 1px solid color-mix(in srgb, var(--violet) 35%, var(--line)); border-radius: 50%; }
  .focus-glyph::before, .focus-glyph::after, .focus-glyph i { width: 1.55rem; height: 1.55rem; position: absolute; border: 1px solid var(--violet); border-radius: 50%; content: ''; }
  .focus-glyph::before { transform: translateX(-.48rem); } .focus-glyph::after { transform: translateX(.48rem); } .focus-glyph i { transform: translateY(.48rem); opacity: .45; }
  .focus-card:nth-child(2) .focus-glyph { border-radius: 20%; transform: rotate(45deg); }
  .focus-card h3 { margin: 0; font-family: var(--font-display); font-size: clamp(1.3rem, 2vw, 1.6rem); font-weight: 560; letter-spacing: -.025em; }
  .focus-card p { margin: .7rem 0 0; color: var(--muted); font-size: .9rem; line-height: 1.65; }
  .research-section { border-top: 1px solid var(--line); color: var(--ink); background: #edf1f4; }
  .research-heading { margin-bottom: clamp(2rem, 4vw, 3rem); }
  .research-list { display: grid; gap: 1rem; }
  .research-card { display: grid; grid-template-columns: 76px 1fr; gap: 1.5rem; padding: clamp(1.5rem, 3vw, 2.25rem); border: 1px solid #d6dde2; border-radius: var(--radius-md); background: rgba(255,255,255,.82); }
  .research-number { color: #7890a0; font-family: var(--font-display); font-size: 2.25rem; font-style: italic; }
  .research-label { margin: 0; color: var(--violet) !important; font-size: .72rem !important; font-weight: 760; letter-spacing: .1em; text-transform: uppercase; }
  .research-copy { min-width: 0; }
  .research-copy h3 { margin: .45rem 0 0; max-width: 800px; overflow-wrap: anywhere; font-family: var(--font-display); font-size: clamp(1.5rem, 2.5vw, 2rem); font-weight: 520; letter-spacing: -.03em; }
  .research-copy > p { max-width: 850px; margin: .7rem 0 0; color: var(--muted); font-size: .94rem; line-height: 1.7; }
  .research-copy ul { display: flex; flex-wrap: wrap; gap: .4rem; margin: 1rem 0 0; padding: 0; list-style: none; }
  .research-copy li { padding: .32rem .58rem; border: 1px solid #cdd6dc; border-radius: 999px; color: #586873; background: #f8fafb; font-size: .72rem; }
  .about-grid { display: grid; grid-template-columns: minmax(110px, .3fr) minmax(0, 1.7fr); gap: clamp(2rem, 5vw, 5rem); }
  .about-content { min-width: 0; }
  .about-label { margin-top: .35rem; }
  .lead { max-width: 850px; margin: 0; font-family: var(--font-display); font-size: clamp(1.2rem, 1.8vw, 1.5rem); line-height: 1.55; }
  .lead a { overflow-wrap: anywhere; color: var(--violet); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: .18em; }
  @media (max-width: 900px) { .hero-grid { grid-template-columns: 1fr; } .identity-card { max-width: 460px; } .signal-field { width: 100vw; opacity: .2; } .focus-grid { grid-template-columns: 1fr; } .focus-card { min-height: auto; } .about-grid { grid-template-columns: 1fr; gap: 2rem; } .about-label { margin: 0; } }
  @media (max-width: 620px) { .hero { min-height: auto; padding-top: 3.5rem; } h1 { font-size: clamp(3rem, 14vw, 4.4rem); } .identity-card { padding: .8rem; } .portrait-visual { min-height: 200px; } .education-row { grid-template-columns: 48px 1fr; } .education-row > .eyebrow-text { grid-column: 1 / -1; } .education-mark { width: 46px; height: 46px; } .education-mark img { width: 38px; height: 38px; } .research-card { grid-template-columns: 1fr; gap: .4rem; } .research-number { font-size: 1.8rem; } }
</style>
